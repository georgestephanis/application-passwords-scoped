<?xml version="1.0"?>
<ruleset name="Scoped Application Passwords">
    <description>WordPress coding standards for Scoped Application Passwords.</description>

    <file>application-passwords-scoped.php</file>
    <file>includes/</file>

    <arg name="basepath" value="."/>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="WordPress"/>

    <config name="minimum_supported_wp_version" value="6.9"/>
    <config name="text_domain" value="application-passwords-scoped"/>
</ruleset>
