<?xml version="1.0"?>
<ruleset name="Scoped Application Passwords">
    <description>WordPress Coding Standards, plus PHP compatibility checks, for Scoped Application Passwords.</description>

    <file>application-passwords-scoped.php</file>
    <file>uninstall.php</file>
    <file>includes/</file>
    <file>tests/playground/</file>
    <file>.github/setup.php</file>

    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/node_modules/*</exclude-pattern>

    <arg name="basepath" value="."/>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg name="parallel" value="8"/>
    <arg value="sp"/>

    <!-- WordPress-Core, WordPress-Docs and WordPress-Extra. -->
    <rule ref="WordPress"/>

    <!-- Matches `Requires PHP` in the plugin header. -->
    <rule ref="PHPCompatibilityWP"/>
    <config name="testVersion" value="7.4-"/>

    <config name="minimum_supported_wp_version" value="6.9"/>
    <config name="text_domain" value="application-passwords-scoped"/>

    <!-- Global prefixes, so non-namespaced code (uninstall.php, demo setup) can't collide. -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="Application_Passwords_Scoped"/>
                <element value="application_password_scope"/>
            </property>
        </properties>
    </rule>

    <!-- Test fixtures and demo setup are not shipped, and run only inside Playground. -->
    <rule ref="WordPress.Security.NonceVerification">
        <exclude-pattern>/tests/*</exclude-pattern>
    </rule>
</ruleset>
